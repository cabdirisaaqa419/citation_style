<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" default-locale="en-US" class="in-text" page-range-format="minimal">
  <info>
    <title>Custom: Initials.Lastname, ... for et-al, DOI with prefix</title>
    <id>https://www.zotero.org/styles/custom-initials-dots-doi</id>
    <updated>2026-06-11T12:00:00+00:00</updated>
  </info>
  <locale xml:lang="en">
    <terms>
      <term name="et-al">...</term>
    </terms>
  </locale>
  <!-- Author: Y. Imanbayev, Y. Tileuberdi, Y. Ongarbayev, ... -->
  <macro name="author">
    <names variable="author" et-al-min="4" et-al-use-first="3">
      <name initialize="true" initialize-with=". " name-as-sort-order="first" delimiter=", " delimiter-precedes-last="always"/>
    </names>
  </macro>
  <macro name="year">
    <date variable="issued"><date-part name="year"/></date>
  </macro>
  <!-- In-text citation: [43] -->
  <citation collapse="citation-number">
    <sort><key variable="citation-number"/></sort>
    <layout prefix="[" suffix="]" delimiter=",">
      <text variable="citation-number"/>
    </layout>
  </citation>
  <!-- Bibliography entry -->
  <bibliography et-al-min="4" et-al-use-first="3" entry-spacing="0">
    <layout suffix=".">
      <!-- Number and authors -->
      <text variable="citation-number" prefix="[" suffix="]"/> <text macro="author"/>
      <!-- For journal articles (default case) -->
      <choose>
        <if type="article-journal" match="any">
          <group suffix=", ">
            <text variable="title" suffix=", "/>
            <text variable="container-title" suffix=", "/>
            <text macro="year" suffix=", "/>
            <text variable="volume" suffix=", "/>
            <text variable="page"/>
          </group>
          <text value=", doi: "/>
          <text variable="DOI"/>
        </if>
        <!-- Fallback for other types (books, chapters, etc.) – adjust as needed -->
        <else>
          <text variable="title" suffix=". "/>
          <text variable="container-title" suffix=", "/>
          <text macro="year" suffix=". "/>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>